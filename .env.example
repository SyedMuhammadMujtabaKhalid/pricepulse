# ============================================================
# PricePulse — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Database ---
POSTGRES_USER=pricepulse
POSTGRES_PASSWORD=pricepulse_secret
POSTGRES_DB=pricepulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Constructed from above — override if using external DB
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Pipeline ---
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_RETRY_DELAY_SECONDS=2

# --- Scraper ---
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000

# --- pgAdmin (Docker only) ---
PGADMIN_EMAIL=admin@pricepulse.dev
PGADMIN_PASSWORD=admin
